<!DOCTYPE html>

<html lang="pt-BR">

<head><link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<meta name="theme-color" content="#080808">

<title>ONL1NE</title>

<style>

*{box-sizing:border-box}

body{margin:0;background:#080808;color:#fff;font-family:Arial,sans-serif}

header{padding:25px 18px;background:#111;border-bottom:2px solid #e00024}

.logo{font-size:32px;font-weight:900;letter-spacing:3px}

.logo span{color:#ed1235}

header p{color:#aaa;margin:6px 0}

nav{display:flex;overflow:auto;gap:8px;padding:12px;background:#111}

button{background:#222;color:white;border:1px solid #444;border-radius:9px;padding:12px;cursor:pointer}

nav button.active,.primary{background:#d90029;border-color:#d90029}

main{padding:16px;max-width:700px;margin:auto}

.panel{background:#151515;border:1px solid #333;border-radius:14px;padding:17px;margin:12px 0}

h2{color:#ff2347;margin-top:5px}

h3{font-size:16px}

small,.muted{color:#aaa}

input,select{width:100%;padding:12px;margin:8px 0;background:#090909;color:white;border:1px solid #444;border-radius:8px}

input[type=range]{padding:0;accent-color:#ed1235}

.action{width:100%;margin-top:8px}

.tab{display:none}.tab.active{display:block}

.item{padding:10px;border-bottom:1px solid #333;display:flex;justify-content:space-between;gap:8px}

.value{color:#ff3656;font-weight:bold}

footer{text-align:center;color:#777;padding:25px}

</style>

</head>

<body>

<header>

 <div class="logo">ONL<span>1</span>NE</div>

 <p>SEU PAINEL DE CONFIGURAÇÕES</p>

</header>

<nav>

 <button class="active" onclick="openTab('inicio',this)">Início</button>

 <button onclick="openTab('hud',this)">HUD</button>

 <button onclick="openTab('sens',this)">Sensibilidade</button>

 <button onclick="openTab('treino',this)">Treinamento</button>

 <button onclick="openTab('perfis',this)">Perfis</button>

</nav>

<main>

<section id="inicio" class="tab active">

 <div class="panel">

  <h2>Bem-vindo ao ONL1NE</h2>

  <p>Seu espaço para organizar suas configurações e acompanhar sua evolução.</p>

  <p class="muted">Tudo organizado em um só lugar.</p>

 </div>

 <div class="panel">

  <h3>Seu painel</h3>

  <p>🎮 Organizador de HUD</p>

  <p>🎯 Sensibilidade personalizada</p>

  <p>📈 Histórico de treinamento</p>

  <p>💾 Perfis salvos no dispositivo</p>

 </div>

</section>

<section id="hud" class="tab">

 <div class="panel">

  <h2>Organizador HUD</h2>

  <p class="muted">Adicione os botões que deseja organizar.</p>

  <input id="hudInput" placeholder="Ex.: Botão de tiro">

  <button class="primary action" onclick="addHud()">+ Adicionar botão</button>

  <div id="hudList"></div>

 </div>

</section>

<section id="sens" class="tab">

 <div class="panel">

  <h2>Sensibilidade</h2>

  <p class="muted">Personalize e registre seus valores.</p>

  <div id="sliders"></div>

  <button class="primary action" onclick="saveSens()">Salvar sensibilidade</button>

 </div>

</section>

<section id="treino" class="tab">

 <div class="panel">

  <h2>Treinamento</h2>

  <input id="trainingName" placeholder="Nome do treino">

  <input id="trainingResult" placeholder="Resultado ou observação">

  <button class="primary action" onclick="addTraining()">Registrar resultado</button>

  <h3>Seu histórico</h3>

  <div id="trainingList"></div>

 </div>

</section>

<section id="perfis" class="tab">

 <div class="panel">

  <h2>Meus perfis</h2>

  <input id="profileName" placeholder="Nome do perfil">

  <button class="primary action" onclick="saveProfile()">Salvar perfil atual</button>

  <select id="profileSelect"><option value="">Escolha um perfil</option></select>

  <button class="action" onclick="loadProfile()">Carregar perfil</button>

  <button class="action" onclick="deleteProfile()">Excluir perfil selecionado</button>

 </div>

</section>

</main>

<footer>ONL1NE • SEU JOGO, SUAS CONFIGURAÇÕES</footer>

<script>

const defaults={Geral:100,"Ponto vermelho":100,"Mira 2x":100,"Mira 4x":100,"Mira AWM":50,"Olhadinha":100};

let sens=JSON.parse(localStorage.getItem("onl_sens")||"null")||{...defaults};

let hud=JSON.parse(localStorage.getItem("onl_hud")||"[]");

let training=JSON.parse(localStorage.getItem("onl_training")||"[]");

let profiles=JSON.parse(localStorage.getItem("onl_profiles")||"{}");

function openTab(id,btn){

 document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));

 document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));

 document.getElementById(id).classList.add("active");

 btn.classList.add("active");

}

function renderHud(){

 document.getElementById("hudList").innerHTML=hud.map((x,i)=>

 `<div class="item">${escapeHTML(x)} <button onclick="removeHud(${i})">Excluir</button></div>`).join("");

}

function addHud(){

 let v=document.getElementById("hudInput").value.trim();

 if(!v)return;

 hud.push(v);localStorage.setItem("onl_hud",JSON.stringify(hud));

 document.getElementById("hudInput").value="";renderHud();

}

function removeHud(i){hud.splice(i,1);localStorage.setItem("onl_hud",JSON.stringify(hud));renderHud()}

function renderSens(){

 document.getElementById("sliders").innerHTML=Object.entries(sens).map(([k,v],i)=>

 `<label>${k}: <span class="value" id="v${i}">${v}</span></label>

 <input type="range" min="0" max="200" value="${v}" oninput="changeSens('${k}',this.value,${i})">`).join("");

}

function changeSens(k,v,i){sens[k]=Number(v);document.getElementById("v"+i).textContent=v}

function saveSens(){localStorage.setItem("onl_sens",JSON.stringify(sens));alert("Sensibilidade salva!")}

function addTraining(){

 let n=document.getElementById("trainingName").value.trim();

 let r=document.getElementById("trainingResult").value.trim();

 if(!n||!r)return alert("Preencha o treino e o resultado.");

 training.unshift({n,r,date:new Date().toLocaleDateString("pt-BR")});

 localStorage.setItem("onl_training",JSON.stringify(training));

 document.getElementById("trainingName").value="";

 document.getElementById("trainingResult").value="";

 renderTraining();

}

function renderTraining(){

 document.getElementById("trainingList").innerHTML=training.map(x=>

 `<div class="item"><span><b>${escapeHTML(x.n)}</b><br><small>${escapeHTML(x.date)} • ${escapeHTML(x.r)}</small></span></div>`).join("");

}

function saveProfile(){

 let n=document.getElementById("profileName").value.trim();

 if(!n)return alert("Digite um nome para o perfil.");

 profiles[n]={sens:{...sens},hud:[...hud]};

 localStorage.setItem("onl_profiles",JSON.stringify(profiles));

 renderProfiles();alert("Perfil salvo!");

}

function renderProfiles(){

 document.getElementById("profileSelect").innerHTML='<option value="">Escolha um perfil</option>'+

 Object.keys(profiles).map(n=>`<option>${escapeHTML(n)}</option>`).join("");

}

function loadProfile(){

 let n=document.getElementById("profileSelect").value;

 if(!n||!profiles[n])return;

 sens={...profiles[n].sens};hud=[...profiles[n].hud];

 localStorage.setItem("onl_sens",JSON.stringify(sens));

 localStorage.setItem("onl_hud",JSON.stringify(hud));

 renderSens();renderHud();alert("Perfil carregado!");

}

function deleteProfile(){

 let n=document.getElementById("profileSelect").value;

 if(!n)return;

 delete profiles[n];localStorage.setItem("onl_profiles",JSON.stringify(profiles));renderProfiles();

}

function escapeHTML(s){

 return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

}

renderHud();renderSens();renderTraining();renderProfiles();

</script>

</body>

</html>
